        "field": "urgent",
        "value": true
      },
      "route": "priority_queue"
    },
    {
      "id": "r3",
      "order": 3,
      "implements": [
        "REQ-3"
      ],
      "condition": {
        "op": "cmp",
        "field": "waiting_time",
        "cmp": ">=",
        "value": {
          "n": "25",
          "unit": "minutes"
        }
      },
      "route": "escalation"
    },
    {
      "id": "r5",
      "order": 4,
      "implements": [
        "REQ-5"
      ],
      "condition": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "field": "customer_tier",
            "value": "vip"
          },
          {
            "op": "cmp",
            "field": "waiting_time",
            "cmp": ">=",
            "value": {
              "n": "15",
              "unit": "minutes"
            }
          }
        ]
      },
      "route": "escalation"
    },
    {
      "id": "r4",
      "order": 99,
      "implements": [
        "REQ-4"
      ],
      "condition": {
        "op": "true"
