{
  "rules": [
    {
      "id": "r1",
      "order": 1,
      "implements": [
        "REQ-1"
      ],
      "condition": {
        "op": "is_missing",
        "field": "category"
      },
      "route": "manual_review"
    },
    {
      "id": "r2",
      "order": 2,
      "implements": [
        "REQ-2"
      ],
      "condition": {
